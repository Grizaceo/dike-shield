# Copiar a .env y completar. .env está en .gitignore: nunca versionarlo.
# La clave de NVIDIA NO va aquí: se configura en la pestaña Providers de Nightshift.

# Meterless Nightshift (VM Windows en la red local). URL y token salen de la Console de Nightshift.
METERLESS_BASE_URL=http://<ip-de-la-vm>:8088/v1
METERLESS_RUNTIME_TOKEN=<token-de-la-console-de-nightshift>
METERLESS_APP=dike-shield
# Rutas meterless/* respaldadas por Nemotron, descubiertas con GET /models (fase 0)
METERLESS_MODEL_FAST=<ruta-meterless-del-lane-nemotron-lightning>
METERLESS_MODEL_DEEP=<ruta-meterless-del-lane-nemotron-super>

# Zetaris (instalación local en Docker). La API key la crea el autor en la UI de Zetaris.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=<api-key-de-zetaris>
ZETARIS_SOURCE_DB=<nombre-de-la-lightning-database-registrada>
ZETARIS_ENABLE_BCN=false

# Postgres del Shield (docker-compose.yml de este repo)
SHIELD_DB_PASSWORD=<password-local>
SHIELD_DB_URL=postgresql://shield:<password-local>@localhost:55432/shield

# Diké: estado aislado dentro del repo (carpeta .local/, ignorada)
DIKE_HOME_DIR=.local/dike-home
DIKE_SIGNING_KEY_PATH=.local/keys/demo-content-signing-key.pem

# Sidecar de Meterless Engines
ENGINES_URL=http://127.0.0.1:8790

# Comportamiento
SAMPLE_MODE=false
SHIELD_MAX_ITER=3
BENCH_N_PREGUNTAS=30
