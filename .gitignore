# Secretos y entorno local
.env
.env.*
!.env.example

# Carpetas locales, nunca versionadas: notas de la máquina, artefactos privados,
# estado aislado de Diké (corpus instalado, caches) y claves de demo
.hackathon/
.local/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node (sidecar de Meterless Engines)
node_modules/
engines/**/dist/

# QA renders of the pitch deck (the .pptx is the deliverable)
docs/deck/slide-*.jpg
docs/deck/*.pdf

# Datos de ejecución (las respuestas grabadas para SAMPLE_MODE sí se versionan en data/cache/)
data/runtime/
*.log

# Artefactos de build de setuptools (pip/uv construyen dentro del árbol de vendor/dike)
build/
*.egg-info/
